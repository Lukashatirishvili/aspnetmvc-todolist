@model List<Todo>

@{
    ViewData["Title"] = "Todolist";
}

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center">
        <h2>Todo List</h2>
        <a asp-action="CreateTodo" class="btn btn-success">Create Todo</a>
    </div>
    
    <ul class="list-group mt-5">
        @foreach (var item in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center mb-3 shadow-sm rounded">
                <span class="@(item.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                    @item.TodoText
                </span>
                <div>
                    <a asp-action="EditTodo" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                    
                    <form asp-action="DeleteTodo" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-danger">
                            Delete
                        </button>
                    </form>
                    
                    @if (item.IsCompleted)
                    {
                        <form asp-action="UndoCompletion" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@item.Id"/>
                            <button type="submit" class="btn btn-sm btn-success">Completed</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Completion" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@item.Id"/>
                            <button type="submit" class="btn btn-sm btn-warning">Complete</button>
                        </form>
                    }
                </div>
            </li>
        }
    </ul>
</div>


