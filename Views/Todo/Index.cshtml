@model List<Todo>

@{
    ViewData["Title"] = "Todolist";
}

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center">
        <h2>Todo List</h2>
        <a asp-action="Create" class="btn btn-success">Create Todo</a>
    </div>
    
    <ul class="list-group mt-5">
        @foreach (var item in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center mb-3 shadow-sm rounded">
                <span>@item.TodoText</span>
                <div>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    <a asp-action="Complete" asp-route-id="@item.Id" class="btn btn-sm btn-success">Completed</a>
                </div>
            </li>
        }
    </ul>
</div>